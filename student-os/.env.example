# Copy to `.env` next to this file (skill root) or in your working directory, then fill in values.
# Prefer the skill-root `.env` for installed copy installs; for symlink installs the same path
# lives inside this repository checkout, so keep it gitignored and never commit real tokens.
# Never commit a real .env file.

# MinerU precision API token used by materials_convert.py --method api|auto
MINERU_TOKEN=
# Optional alias accepted by the same loader
# MINERU_API_TOKEN=
